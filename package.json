{
  "name": "devloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./db/migrate.ts",
    "db:check": "bun run ./db/check.ts",
    "audit": "bun run ./scripts/audit.ts",
    "secrets:scan": "bun run ./scripts/scan-secrets.ts",
    "secrets:scan:baseline": "bun run ./scripts/scan-secrets.ts --write-baseline",
    "secrets:hook:install": "bun run ./scripts/install-secret-hook.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.9.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "esbuild": "0.28.2"
  }
}
