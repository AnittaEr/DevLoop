# DevLoop is local-only in v1 (D2): there is no hosted database.
# Copy this file to `.env` and point DATABASE_URL at your local Postgres.
# `.env` is gitignored — never commit a real connection string.

# Local PostgreSQL connection string used by drizzle-kit, db:migrate and the
# runtime client in src/lib/db/client.ts.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/devloop

# DevLoop environment variables — COPY TO .env AND FILL IN. Never commit .env.
#
# GitHub fine-grained personal access token (D-024a / D-041).
# Read by src/core/credentials/env-provider.ts; the source is selected
# explicitly by src/core/credentials/factory.ts, never by this file.
# Create one at https://github.com/settings/personal-access-tokens/new with the
# minimum scopes the GitHub plugin needs. Leave the value empty here.
GITHUB_FINE_GRAINED_PAT=

# Better Auth (T19) — REQUIRED to serve any /api/auth/* request.
# requireAuthSecret() in src/lib/auth.ts refuses a missing or default value at
# request time and the route answers 503 auth_not_configured, so auth is dead
# until this is set — that refusal is DevLoop's, not the library's, which only
# rejects its own default secret under NODE_ENV=production (a mode v1 never runs
# in: no deployment).
# DevLoop never stores, logs or defaults it. Generate with `openssl rand -base64 32`.
# Leave the value EMPTY here — a committed secret would be a live credential.
BETTER_AUTH_SECRET=

# Base URL Better Auth derives cookie domain, redirects and the /api/auth/*
# mount point from. Optional: src/lib/auth.ts defaults it to
# http://localhost:3000, the Next.js dev port. An EMPTY value counts as unset and
# gets that default, so leaving this blank is correct — you only fill it in when
# you run the app somewhere other than the local dev port.
BETTER_AUTH_URL=
